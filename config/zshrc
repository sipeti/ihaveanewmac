# Managed starting point for ihaveanewmac.
# Personal additions can be placed below the managed section.

export PATH="$HOME/bin:/usr/local/bin:$HOME/.local/bin:$PATH"
export ZSH="$HOME/.oh-my-zsh"

ZSH_THEME="agnoster"

zstyle ':omz:update' mode auto
zstyle ':omz:update' frequency 13

plugins=(
  git
  macos
  docker
  docker-compose
)

source "$ZSH/oh-my-zsh.sh"

# Shell niceties installed by Homebrew.
[[ -r "$(brew --prefix 2>/dev/null)/share/zsh-autosuggestions/zsh-autosuggestions.zsh" ]] && \
  source "$(brew --prefix)/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
[[ -r "$(brew --prefix 2>/dev/null)/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]] && \
  source "$(brew --prefix)/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"

# Homebrew Python / pyenv
export PYENV_ROOT="$HOME/.pyenv"
command -v pyenv >/dev/null 2>&1 && export PATH="$PYENV_ROOT/bin:$PATH"
command -v pyenv >/dev/null 2>&1 && eval "$(pyenv init -)"

# Keep Homebrew outside pyenv shims when a pyenv-managed executable shadows it.
if command -v pyenv >/dev/null 2>&1; then
  alias brew='env PATH="${PATH//$(pyenv root)\/shims:/}" brew'
fi

# SDKMAN - keep at the end of managed shell initialization.
export SDKMAN_DIR="$HOME/.sdkman"
[[ -s "$HOME/.sdkman/bin/sdkman-init.sh" ]] && source "$HOME/.sdkman/bin/sdkman-init.sh"

